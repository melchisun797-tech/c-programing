//write a program that takes a student's marks as input and prints their grade.
//Use these rules:
//90–100 → A
//75–89  → B
//60–74  → C
//40–59  → D
//Below 40 → Fail


#include <stdio.h>
int main()
{
    int mark;
    printf("enter your mark");
    scanf("%d",&mark);
    if(mark>=90&&mark<=100)
    {
        printf("Grade=A");
    }
    else if(mark>=75&&mark<=89)
    {
        printf("Grade=B");
    }
    else if(mark>=60&&mark<=74)
    {
        printf("Grade=C");
    }
    else if(mark>=40&&mark<=59)
    {
        printf("Grade=D");
    }
    else
    {
        printf("Grade=fail");
    }
    return 0;
}
